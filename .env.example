# ————————————————————————————————————————————————
# حساب‌یار کارن سافت — نمونه متغیرهای محیطی
# این اپ کاملاً آفلاین و بدون سرور کار می‌کند؛ متغیرهای زیر اختیاری‌اند.
# ————————————————————————————————————————————————

# شماره تماس پشتیبانی فروش (نمایش در صفحه لایسنس)
VITE_SUPPORT_PHONE=021-00000000

# حالت توسعه سرویس‌ورکر PWA (معمولاً خالی بماند)
# VITE_PWA_DEV=false

# ————— لایسنس سروری (اختیاری؛ فقط برای بیلد آزمایشی/فروش) —————
# اگر خالی بماند، اپ مثل قبل با کلید آفلاین KS1 کار می‌کند.
# برای staging وب: /v1 (هم‌مبدأ) — برای اپ اندروید بعداً آدرس کامل HTTPS.
# VITE_LICENSE_API_BASE=
# محیط مورد انتظار توکن: staging یا production
# VITE_LICENSE_ENV=staging
# اختیاری: کلید عمومی Ed25519 issuer به‌صورت base64 خام برای pin کردن.
# این کلید عمومی است، محرمانه نیست؛ ولی اگر ست شود باید دقیقاً با سرور یکی باشد.
# VITE_LICENSE_ISSUER_PUBLIC_KEY=
