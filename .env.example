# ————————————————————————————————————————————————
# حساب‌یار کارن سافت — نمونه متغیرهای محیطی
# بدون تنظیم API، برنامه مثل قبل آفلاین/دمو کار می‌کند.
# ————————————————————————————————————————————————

# شماره تماس پشتیبانی فروش (نمایش در صفحه لایسنس)
VITE_SUPPORT_PHONE=021-00000000

# حالت توسعه سرویس‌ورکر PWA (معمولاً خالی بماند)
# VITE_PWA_DEV=false

# ————— لایسنس سروری (فعال‌کردن این حالت اختیاری است) —————
# اگر API خالی بماند، حالت آفلاین KS1 باقی می‌ماند.
# با تنظیم API، تمام مقادیر اعتماد زیر اجباری‌اند؛ build ناقص متوقف می‌شود.
# کلید عمومی secret نیست؛ هیچ کلید خصوصی یا رمز سرور را با VITE_ منتشر نکنید.
# برای staging وب، npm run build:staging-web از license-trust.json عمومی استفاده می‌کند.
# برای production، کلید و شناسهٔ جداگانه و بازبینی‌شدهٔ همان محیط را تنظیم کنید.
# VITE_LICENSE_API_BASE=/v1
# VITE_LICENSE_ENV=staging
# VITE_LICENSE_ISSUER=karen-license-staging
# VITE_LICENSE_AUDIENCE=hesabyar-app
# VITE_LICENSE_ISSUER_KEY_ID=
# VITE_LICENSE_ISSUER_PUBLIC_KEY=
